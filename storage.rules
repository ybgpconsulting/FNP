rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Default Deny: Disallow all operations across any arbitrary path by default
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Authentication and administrative role verification
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email_verified == true && 
         request.auth.token.email in ['admin@fnpnoida76.com', 'ybgp.consulting@gmail.com'])
      );
    }

    // Validates image MIME types strictly to jpeg, png, and webp with a maximum 5MB size limit
    function isValidProductImage() {
      return request.resource != null &&
             request.resource.size <= 5 * 1024 * 1024 &&
             request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    // Protected catalogue and CMS image paths.
    match /products/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidProductImage();
      allow delete: if isAdmin();
    }

    match /categories/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidProductImage();
      allow delete: if isAdmin();
    }

    match /homepage/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidProductImage();
      allow delete: if isAdmin();
    }
  }
}
