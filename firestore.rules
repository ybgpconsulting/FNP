rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny Catch-All: Deny all read and write operations by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for authentication and role verification
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email_verified == true && 
         request.auth.token.email in ['admin@fnpnoida76.com', 'ybgp.consulting@gmail.com'])
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.slug is string && data.slug.size() > 0 && data.slug.size() <= 150 &&
             data.description is string && data.description.size() <= 2000 &&
             data.price is number && data.price >= 0 &&
             data.categoryId is string && data.categoryId.size() <= 100 &&
             data.available is bool;
    }

    function isValidCategory(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.slug is string && data.slug.size() > 0 && data.slug.size() <= 100 &&
             data.active is bool;
    }

    function isValidDeliverySettings(data) {
      return data.storeLatitude is number &&
             data.storeLongitude is number &&
             data.radiusKm is number &&
             data.radiusKm > 0;
    }

    function isValidSettings(settingId, data) {
      return settingId == 'delivery' ? isValidDeliverySettings(data) : (
        data.businessName is string && data.businessName.size() <= 150 &&
        data.whatsappNumber is string && data.whatsappNumber.size() <= 30 &&
        data.address is string && data.address.size() <= 300
      );
    }

    function isValidHomepage(data) {
      return data.heroTitle is string && data.heroTitle.size() <= 200 &&
             data.heroSubtitle is string && data.heroSubtitle.size() <= 500;
    }

    // 1. Products: Public read, Admin-only write/update/delete
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }

    // 2. Categories: Public read, Admin-only write/update/delete
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(categoryId) && isValidCategory(incoming());
      allow update: if isAdmin() && isValidCategory(incoming());
      allow delete: if isAdmin();
    }

    // 3. Settings: Public read, Admin-only write/update
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidSettings(settingId, incoming());
      allow delete: if false;
    }

    // 4. Homepage CMS: Public read, Admin-only write/update
    match /homepage/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidHomepage(incoming());
      allow delete: if false;
    }

    // 5. Admins Registry: Admin-only access
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // 6. Orders: Completely disabled (privacy-preserving direct WhatsApp ordering flow)
    match /orders/{orderId} {
      allow read, write: if false;
    }
  }
}
