{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store catalogue item such as cakes, flowers, bouquets, gifts, plants, and hampers.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "slug": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 2000 },
        "price": { "type": "number" },
        "oldPrice": { "type": "number" },
        "categoryId": { "type": "string", "maxLength": 100 },
        "categoryName": { "type": "string", "maxLength": 100 },
        "categorySlug": { "type": "string", "maxLength": 100 },
        "images": { "type": "array" },
        "featured": { "type": "boolean" },
        "bestseller": { "type": "boolean" },
        "available": { "type": "boolean" },
        "displayOrder": { "type": "number" },
        "weightOptions": { "type": "array" },
        "allowCustomMessage": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "slug", "description", "price", "categoryId", "available"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category classification for store organisation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "image": { "type": "string", "maxLength": 500 },
        "active": { "type": "boolean" },
        "displayOrder": { "type": "number" }
      },
      "required": ["name", "slug", "active"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Operational information and contact channels for the store.",
      "type": "object",
      "properties": {
        "businessName": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 30 },
        "whatsappNumber": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 300 },
        "mapsUrl": { "type": "string", "maxLength": 500 },
        "zomatoUrl": { "type": "string", "maxLength": 500 },
        "swiggyUrl": { "type": "string", "maxLength": 500 },
        "magicpinUrl": { "type": "string", "maxLength": 500 },
        "openingHours": { "type": "string", "maxLength": 200 }
      },
      "required": ["businessName", "whatsappNumber", "address"]
    },
    "HomepageConfig": {
      "title": "HomepageConfig",
      "description": "Configurable hero banners and promotions displayed on the homepage.",
      "type": "object",
      "properties": {
        "heroTitle": { "type": "string", "maxLength": 200 },
        "heroSubtitle": { "type": "string", "maxLength": 500 },
        "heroImage": { "type": "string", "maxLength": 500 },
        "heroCtaText": { "type": "string", "maxLength": 100 },
        "heroCtaLink": { "type": "string", "maxLength": 200 },
        "promoBannerActive": { "type": "boolean" },
        "promoBannerText": { "type": "string", "maxLength": 300 }
      },
      "required": ["heroTitle", "heroSubtitle"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized administrator account.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Catalogue products accessible publicly for reading and manageable by store administrators."
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Catalogue categories accessible publicly for reading and manageable by store administrators."
    },
    "/settings/{settingId}": {
      "schema": "StoreSettings",
      "description": "Store operational metadata accessible publicly for reading and manageable by store administrators."
    },
    "/homepage/{docId}": {
      "schema": "HomepageConfig",
      "description": "Homepage layout configuration accessible publicly for reading and manageable by store administrators."
    },
    "/admins/{adminId}": {
      "schema": "AdminUser",
      "description": "Administrator registry controlling dashboard authorization boundaries."
    }
  }
}
